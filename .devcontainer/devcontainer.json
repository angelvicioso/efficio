{
  "name": "Efficio POC",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "hostRequirements": { "cpus": 2 },
  "postCreateCommand": "cd web && npm ci && npm run demo:seed",
  "postAttachCommand": { "app": "cd web && npm run dev" },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Efficio", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["web/README.md"] }
  }
}
